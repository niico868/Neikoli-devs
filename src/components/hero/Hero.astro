---
import { HERO_CONFIG as CFG } from '../../scripts/hero/config';
---
<section id="top" class="hero" data-hero aria-label="Introduction">
  <h1 class="sr-only">{CFG.word}</h1>
  <div class="hero__stage" data-stage>
    <canvas class="hero__fx" data-fx aria-hidden="true"></canvas>
    <div class="hero__glow" data-glow aria-hidden="true"></div>

    <!-- Static word: shown without JS and with reduced motion. JS swaps in physics letters. -->
    <p class="hero__static display" aria-hidden="true">{CFG.word}</p>

    <div class="hero__word" data-word role="group" aria-label="NEIKOLI. Each letter opens a card."></div>
    <div class="hero__spawn" data-spawn aria-hidden="true"></div>

    <div class="hero__copy">
      <p class="hero__tagline">{CFG.tagline}</p>
    </div>
    <div class="hero__hint-wrap"><p class="hero__hint">{CFG.hint}</p></div>

    <div class="hero__controls">
      <div class="hero__controls-inner">
        <button type="button" class="hero__btn" data-tilt hidden>Enable tilt</button>
        <button type="button" class="hero__btn" data-reset>Reset</button>
      </div>
    </div>

    <!-- Keepy-uppy (tap the O) -->
    <div class="kick-foot" data-kick-foot aria-hidden="true" hidden></div>
    <div class="kick-counter" data-kick-count hidden><span class="kick-counter__n display" data-kick-n>0</span><span class="kick-counter__label">kicks</span></div>
    <p class="kick-hint" data-kick-hint hidden></p>
    <aside class="hs" data-hs aria-labelledby="hs-title" hidden>
      <div class="hs__head">
        <h2 id="hs-title" class="hs__title">High scores</h2>
        <button type="button" class="hs__close" data-hs-close>Close</button>
      </div>
      <p class="hs__last" data-hs-last aria-live="polite"></p>
      <form class="hs__form" data-hs-form hidden>
        <label for="hs-name">Your initials</label>
        <div class="hs__row">
          <input id="hs-name" name="initials" maxlength="3" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABC" />
          <button type="submit">Save</button>
        </div>
      </form>
      <ol class="hs__list" data-hs-list></ol>
      <p class="hs__again">Tap the O to play again.</p>
    </aside>

    <div class="hero__card" data-card role="dialog" aria-modal="false" aria-labelledby="hero-card-title" hidden>
      <span class="hero__card-key display" data-card-key aria-hidden="true"></span>
      <h2 id="hero-card-title" class="hero__card-title" data-card-title></h2>
      <p class="hero__card-body" data-card-body></p>
      <div class="hero__card-actions">
        <a class="hero__card-link" data-card-link href="#">Go</a>
        <button type="button" class="hero__card-close" data-card-close aria-label="Close card">Close</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountHero } from '../../scripts/hero/hero';
  import { initSmoothScroll } from '../../scripts/motion';
  initSmoothScroll();
  mountHero(document.querySelector<HTMLElement>('[data-hero]'));
</script>

<style>
  .hero {
    position: relative;
    /* 100svh of stage + the scroll distance of the stretch/dock story */
    height: calc(100svh + 220vh);
    /* The next section starts rising over the pinned stage while the word docks,
       so there is no empty screen between the hero and About. */
    margin-bottom: -60svh;
  }
  .hero + :global(*) { position: relative; z-index: 1; background: var(--paper); }
  .hero__stage {
    position: sticky; top: 0;
    height: 100svh; width: 100%;
    overflow: hidden;
    user-select: none; -webkit-user-select: none;
    background: var(--paper);
  }
  .hero__fx { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .hero__glow {
    position: absolute; left: 0; top: 0; z-index: 0; pointer-events: none;
    width: 360px; height: 360px; border-radius: 50%;
    background: var(--accent); filter: blur(70px);
    opacity: 0; visibility: hidden; will-change: transform;
  }

  .hero__static {
    position: absolute; left: 0; right: 0; top: 44%; transform: translateY(-50%);
    margin: 0; text-align: center; line-height: 1;
    font-size: min(16.2vw, 34vh * 1.38);
    letter-spacing: 0;
  }
  :global(.hero.is-ready) .hero__static { display: none; }

  .hero__word { position: absolute; inset: 0; z-index: 2; pointer-events: none; will-change: transform; }
  .hero__spawn { position: absolute; inset: 0; z-index: 2; pointer-events: none; }

  :global(.hero .letter) {
    position: absolute; left: 0; top: 0;
    padding: 0; margin: 0; border: 0; background: none;
    pointer-events: auto; cursor: grab; touch-action: none;
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.hero .letter:focus-visible) { outline: 2px solid var(--accent); outline-offset: 6px; }
  :global(.hero.is-grabbing), :global(.hero.is-grabbing .letter) { cursor: grabbing; }
  :global(.hero .glyph) {
    position: absolute; left: 0; display: block;
    line-height: 1; white-space: pre; color: var(--ink);
    transform-style: preserve-3d; backface-visibility: hidden;
  }
  :global(.hero .letter--typed) { pointer-events: none; }
  :global(.hero .letter--typed .glyph) { color: var(--accent); }

  .hero__copy {
    position: absolute; left: 50%; top: 66%; z-index: 1;
    width: min(24ch, 84vw); margin-left: calc(min(24ch, 84vw) / -2);
    text-align: center;
  }
  .hero__tagline { margin: 0; font-size: var(--step-0); line-height: 1.45; font-weight: 500; }
  .hero__hint-wrap { position: absolute; left: 0; right: 0; bottom: 12%; text-align: center; z-index: 1; }
  .hero__hint {
    margin: 0; font-size: var(--step--1); letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
  }
  .hero__controls { position: absolute; right: var(--gutter); bottom: calc(1rem + env(safe-area-inset-bottom)); z-index: 4; }
  .hero__controls-inner { display: flex; gap: 1rem; }
  .hero__btn {
    background: none; border: 0; padding: .6rem .2rem; cursor: pointer;
    font-size: var(--step--1); letter-spacing: .08em; text-transform: uppercase;
    text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line);
  }
  .hero__btn:hover { color: var(--accent); text-decoration-color: currentColor; }

  /* Before the intro plays, the copy and controls wait offstage. */
  :global(html.js:not(.reduced-motion)) .hero:not(.is-static) .hero__tagline,
  :global(html.js:not(.reduced-motion)) .hero:not(.is-static) .hero__hint,
  :global(html.js:not(.reduced-motion)) .hero:not(.is-static) .hero__controls-inner {
    opacity: 0; visibility: hidden; transform: translateY(14px);
  }

  .hero__card {
    position: absolute; left: 0; top: 0; z-index: 5;
    width: min(300px, calc(100vw - 32px));
    background: var(--ink); color: var(--paper);
    padding: 1.3rem 1.3rem 1.1rem; border-radius: 6px;
    box-shadow: 0 18px 40px -18px rgba(17, 17, 17, .5);
    transform-style: preserve-3d; backface-visibility: hidden;
    user-select: text;
  }
  .hero__card-key { font-size: 2.2rem; line-height: 1; color: var(--accent); display: block; margin-bottom: .6rem; }
  .hero__card-title { margin: 0 0 .35rem; font-size: var(--step-1); line-height: 1.2; }
  .hero__card-body { margin: 0 0 1rem; font-size: var(--step--1); opacity: .8; }
  .hero__card-actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .hero__card-link { color: var(--paper); font-weight: 600; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .hero__card-link:hover { color: #fff; }
  .hero__card-close { background: none; border: 0; color: var(--paper); opacity: .6; cursor: pointer; font-size: var(--step--1); }
  .hero__card-close:hover { opacity: 1; }

  /* ---------- Keepy-uppy ---------- */
  :global(.hero.is-playing) .hero__stage { touch-action: none; cursor: crosshair; }
  :global(.kick-ball) {
    position: absolute; left: 0; top: 0; z-index: 3; pointer-events: none; will-change: transform;
    filter: drop-shadow(0 6px 6px rgba(17, 17, 17, .18));
  }
  :global(.kick-ball svg) { display: block; }
  .kick-foot {
    position: absolute; left: -22px; top: -22px; z-index: 3; pointer-events: none;
    width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid var(--accent); background: rgba(139, 15, 20, .08);
  }
  .kick-counter {
    position: absolute; left: 0; right: 0; top: clamp(4.5rem, 14vh, 8rem); z-index: 4;
    display: flex; flex-direction: column; align-items: center; pointer-events: none;
  }
  .kick-counter__n {
    display: block; color: var(--accent); line-height: 1;
    font-size: clamp(3.2rem, 9vw, 7rem); font-variant-numeric: tabular-nums;
  }
  .kick-counter__label { font-size: var(--step--1); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-2); }
  .kick-hint {
    position: absolute; left: 0; right: 0; bottom: 22%; z-index: 4; margin: 0; text-align: center; pointer-events: none;
    font-size: var(--step--1); letter-spacing: .14em; text-transform: uppercase; color: var(--ink);
  }
  .hs {
    position: absolute; z-index: 6;
    right: calc(var(--gutter) + env(safe-area-inset-right, 0px));
    bottom: calc(3.6rem + env(safe-area-inset-bottom, 0px));
    width: min(280px, calc(100vw - 32px));
    max-height: calc(100svh - 9rem); overflow: auto;
    background: var(--paper); border: 1.5px solid var(--ink); border-radius: 6px;
    padding: 1rem 1.1rem 1.1rem;
    box-shadow: 6px 6px 0 var(--ink);
    user-select: text;
  }
  .hs__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .hs__title { margin: 0; font-size: var(--step--1); letter-spacing: .16em; text-transform: uppercase; }
  .hs__close { background: none; border: 0; padding: .3rem 0; cursor: pointer; font-size: var(--step--1); color: var(--ink-2); }
  .hs__close:hover { color: var(--accent); }
  .hs__last { margin: .5rem 0 .8rem; font-size: var(--step--1); color: var(--ink-2); }
  .hs__form { display: grid; gap: .35rem; margin-bottom: .9rem; font-size: var(--step--1); }
  .hs__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .5rem; }
  .hs__row input {
    width: 100%; min-width: 0; font: inherit; font-weight: 700; letter-spacing: .3em; text-transform: uppercase;
    padding: .5rem .6rem; border: 1.5px solid var(--ink); border-radius: 4px; background: #fff; color: var(--ink);
  }
  .hs__row button {
    font-weight: 600; padding: .5rem .9rem; border: 0; border-radius: 4px; cursor: pointer;
    background: var(--accent); color: var(--accent-ink);
  }
  .hs__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .1rem; font-variant-numeric: tabular-nums; }
  :global(.hs__list li) {
    display: grid; grid-template-columns: 2rem 1fr auto; gap: .5rem; align-items: baseline;
    padding: .28rem .35rem; border-radius: 3px; font-size: var(--step--1);
  }
  :global(.hs__list li.is-you) { background: var(--accent); color: var(--accent-ink); }
  :global(.hs__list li.is-you .hs__rank) { color: inherit; }
  :global(.hs__list .hs__empty) { display: block; color: var(--ink-2); }
  :global(.hs__rank) { color: var(--ink-2); }
  :global(.hs__name) { font-weight: 700; letter-spacing: .12em; }
  :global(.hs__pts) { font-weight: 700; }
  .hs__again { margin: .8rem 0 0; font-size: var(--step--1); color: var(--accent); }

  /* Static hero: no JS or prefers-reduced-motion. One screen, no scroll story. */
  :global(html:not(.js)) .hero, :global(html.reduced-motion) .hero, :global(.hero.is-static) { height: 100svh; margin-bottom: 0; }
  :global(html:not(.js)) .hero__controls, :global(html.reduced-motion) .hero__controls, :global(.hero.is-static) .hero__controls,
  :global(html:not(.js)) .hero__hint-wrap, :global(html.reduced-motion) .hero__hint-wrap, :global(.hero.is-static) .hero__hint-wrap { display: none; }
</style>
