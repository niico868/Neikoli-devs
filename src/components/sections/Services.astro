---
import KineticTitle from '../KineticTitle.astro';
import { packages, carePlans, addOns, metaAds, usd, ttd } from '../../data/site';
---
<section id="services" class="section services" aria-labelledby="services-title">
  <div class="wrap">
    <p class="section__label"><span>04</span> / Services and pricing</p>
    <KineticTitle id="services-title" text="Prices, out in the open." mode="snap" class="services__title" accentLast />
    <p class="services__intro">Every build is quoted by package, in US dollars. The one-time SEO setup is included in every build.</p>

    <div class="pkgs">
      {packages.map((p, i) => (
        <article class:list={['pkg', { 'pkg--top': i === packages.length - 1 }]} data-pkg>
          <header>
            <h3 class="pkg__name">{p.name}</h3>
            <p class="pkg__price"><span data-count={p.price}>{usd(p.price)}</span><small>USD</small></p>
            <p class="pkg__tagline">{p.tagline}</p>
          </header>
          <ul class="pkg__list">{p.includes.map((x) => <li>{x}</li>)}</ul>
          {p.note && <p class="pkg__note">{p.note}</p>}
        </article>
      ))}
    </div>

    <div class="block">
      <h3 class="block__title">Monthly care plans</h3>
      <p class="block__intro">Pitched with every proposal, not after launch. Each tier has a cap on edit hours, and new features are always quoted separately.</p>
      <ul class="care" role="list">
        {carePlans.map((c) => (
          <li data-care>
            <strong>{c.name}</strong>
            <span class="care__price">{ttd(c.ttd)}<small>/month</small></span>
            <p>{c.blurb}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="block">
      <h3 class="block__title">Add-ons</h3>
      <p class="block__intro">Any service can be added to any plan for a monthly fee. A service bought on its own always costs more than it does inside a plan. TTD prices are approximate, at about TT$6.8 to US$1.</p>
      <div class="table-scroll">
        <table class="addons">
          <thead><tr><th scope="col">Service</th><th scope="col">USD / month</th><th scope="col">About TTD / month</th><th scope="col">What it is</th></tr></thead>
          <tbody>{addOns.map((a) => <tr><th scope="row">{a.name}</th><td>{a.usd}</td><td>{a.ttd}</td><td>{a.what}</td></tr>)}</tbody>
        </table>
      </div>
    </div>

    <div class="block">
      <h3 class="block__title">Meta ads: two ways</h3>
      <p class="block__intro">Ad spend is always billed separately and targets are agreed up front. Account setup (Business Manager, pixel, conversion tracking, audiences) is a one-time fee.</p>
      <div class="ads">
        {metaAds.map((m) => (
          <article class="ad">
            <h4>{m.name}</h4>
            <p class="ad__price">{m.usd} <small>· {m.ttd} / month</small></p>
            <p>{m.what}</p>
            <p class="ad__hours">{m.hours}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  :global(.services__title) { font-size: var(--step-3); max-width: 14ch; }
  .services__intro { color: var(--ink-2); max-width: 56ch; margin: 1.2rem 0 2.5rem; }
  .pkgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; margin-bottom: 4rem; align-items: stretch; }
  .pkg { border: 1.5px solid var(--ink); border-radius: 6px; padding: 1.6rem; display: flex; flex-direction: column; gap: 1rem; background: var(--paper); }
  .pkg--top { background: var(--ink); color: var(--paper); }
  .pkg__name { margin: 0; font-size: var(--step--1); letter-spacing: .16em; text-transform: uppercase; }
  .pkg__price { margin: .4rem 0 .3rem; font-family: var(--font-display); font-stretch: var(--font-display-stretch); font-weight: 900; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; font-variant-numeric: tabular-nums; display: flex; align-items: baseline; gap: .4rem; }
  .pkg__price small { font-family: var(--font-body); font-stretch: 100%; font-size: var(--step--1); font-weight: 500; opacity: .7; }
  .pkg--top .pkg__price span { color: var(--paper); }
  .pkg__tagline { margin: 0; color: var(--ink-2); }
  .pkg--top .pkg__tagline { color: rgba(244, 241, 234, .75); }
  .pkg__list { margin: 0; padding: 0; list-style: none; display: grid; gap: .55rem; font-size: var(--step--1); }
  .pkg__list li { padding-left: 1.2rem; position: relative; }
  .pkg__list li::before { content: ''; position: absolute; left: 0; top: .55em; width: .5rem; height: .5rem; background: var(--accent); border-radius: 1px; }
  .pkg__note { margin: auto 0 0; font-size: var(--step--1); color: var(--ink-2); border-top: 1px solid var(--line); padding-top: .8rem; }
  .pkg--top .pkg__note { color: rgba(244, 241, 234, .7); }

  .block { margin-bottom: 4rem; }
  .block__title { font-size: var(--step-1); margin: 0 0 .4rem; }
  .block__intro { margin: 0 0 1.4rem; color: var(--ink-2); max-width: 64ch; font-size: var(--step--1); }

  .care { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem; }
  .care li { background: var(--paper-2); padding: 1.3rem; border-radius: 6px; display: grid; gap: .25rem; align-content: start; }
  .care__price { color: var(--accent); font-weight: 700; font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .care__price small { font-size: var(--step--1); font-weight: 500; color: var(--ink-2); }
  .care p { margin: .4rem 0 0; font-size: var(--step--1); color: var(--ink-2); }

  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; }
  .addons { width: 100%; min-width: 640px; border-collapse: collapse; font-size: var(--step--1); }
  .addons th, .addons td { text-align: left; padding: .8rem 1rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .addons thead th { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); font-weight: 600; background: var(--paper-2); }
  .addons tbody th { font-weight: 700; white-space: nowrap; }
  .addons td:nth-child(2), .addons td:nth-child(3) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .addons tr:last-child th, .addons tr:last-child td { border-bottom: 0; }

  .ads { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1rem; }
  .ad { border: 1px solid var(--line); border-radius: 6px; padding: 1.3rem; }
  .ad h4 { margin: 0; font-size: var(--step-0); }
  .ad__price { margin: .3rem 0 .6rem; color: var(--accent); font-weight: 700; }
  .ad__price small { color: var(--ink-2); font-weight: 500; }
  .ad p { margin: 0 0 .6rem; font-size: var(--step--1); }
  .ad__hours { color: var(--ink-2); margin-bottom: 0 !important; }
</style>
