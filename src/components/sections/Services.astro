---
import KineticTitle from '../KineticTitle.astro';
import { packages, carePlans, addOns, metaAdsRates, ttd } from '../../data/site';
---
<section id="services" class="section services" aria-labelledby="services-title" data-cur-scope="ttd">
  <div class="wrap">
    <p class="section__label"><span>05</span> / Services and pricing</p>
    <KineticTitle id="services-title" text="Prices, out in the open." mode="snap" class="services__title" accentLast />
    <p class="services__intro">Every build is quoted by package, in Trinidad and Tobago dollars. The one-time SEO setup is included in every build.</p>

    <div class="pkgs">
      {packages.map((p, i) => (
        <article class:list={['pkg', { 'pkg--top': i === packages.length - 1 }]} data-pkg>
          <header>
            <h3 class="pkg__name">{p.name}</h3>
            <p class="pkg__price"><span data-count={p.price}>{ttd(p.price)}</span><small>TTD</small></p>
            <p class="pkg__tagline">{p.tagline}</p>
          </header>
          <ul class="pkg__list">{p.includes.map((x) => <li>{x}</li>)}</ul>
          {p.note && <p class="pkg__note">{p.note}</p>}
        </article>
      ))}
    </div>

    <div class="block">
      <h3 class="block__title">Monthly care plans</h3>
      <p class="block__intro">Pitched with every proposal, not after launch. Each tier has a cap on edit hours, and new features are always quoted separately.</p>
      <ul class="care" role="list">
        {carePlans.map((c) => (
          <li data-care>
            <strong>{c.name}</strong>
            <span class="care__price">{ttd(c.ttd)}<small>/month</small></span>
            <p>{c.blurb}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="block">
      <div class="block__head">
        <h3 class="block__title">Add-ons</h3>
        <div class="cur" role="group" aria-label="Currency" data-cur>
          <button type="button" aria-pressed="true" data-cur-btn="ttd">TTD</button>
          <button type="button" aria-pressed="false" data-cur-btn="usd">USD</button>
        </div>
      </div>
      <p class="block__intro">Any service can be added to any plan for a monthly fee. A service bought on its own always costs more than it does inside a plan. USD prices are at about TT$6.8 to US$1.</p>
      <div class="table-scroll">
        <table class="addons">
          <thead><tr><th scope="col">Service</th><th scope="col">Price / month</th><th scope="col">What it is</th></tr></thead>
          <tbody>{addOns.map((a) => <tr><th scope="row">{a.name}</th><td><span class="c-ttd">{a.ttd}</span><span class="c-usd">{a.usd}</span></td><td>{a.what}</td></tr>)}</tbody>
        </table>
      </div>
    </div>

    <div class="block">
      <h3 class="block__title">Meta ads: built around you</h3>
      <p class="block__intro">Facebook and Instagram ads are priced on what you actually run, so there's no fixed package. Set the sliders for an estimate. Ad spend is paid to Meta separately, and account setup (Business Manager, pixel, conversion tracking, audiences) is a one-time fee.</p>
      <form class="calc" data-calc data-rates={JSON.stringify(metaAdsRates)} onsubmit="return false">
        <fieldset class="calc__mode">
          <legend class="sr-only">What you need</legend>
          <label><input type="radio" name="mode" value="manage" checked /> <span><b>Management</b><small>You supply the ads; I run them</small></span></label>
          <label><input type="radio" name="mode" value="creative" /> <span><b>Management + creative</b><small>I make the ads too</small></span></label>
        </fieldset>
        <label class="calc__row">
          <span>Ads running each week <output data-out="ads">3</output></span>
          <input type="range" name="ads" min="1" max="15" value="3" />
        </label>
        <div class="calc__creative" data-creative hidden>
          <label class="calc__row">
            <span>New ads made each month <output data-out="per">4</output></span>
            <input type="range" name="per" min="1" max="20" value="4" />
          </label>
          <label class="calc__row">
            <span>Share that are video <output data-out="vid">50%</output></span>
            <input type="range" name="vid" min="0" max="100" step="25" value="50" />
          </label>
        </div>
        <div class="calc__total" aria-live="polite">
          <span class="calc__label">Estimated monthly fee</span>
          <strong data-total>—</strong>
          <small data-breakdown></small>
        </div>
        <p class="calc__note">This is an estimate, not a quote. Your final price depends on goals, audiences and how much testing the account needs. Plan on ad spend of at least <span data-minspend></span> per ad set, paid directly to Meta.</p>
      </form>
    </div>
  </div>
</section>
<style>
  :global(.services__title) { font-size: var(--step-3); max-width: 14ch; }
  .services__intro { color: var(--ink-2); max-width: 56ch; margin: 1.2rem 0 2.5rem; }
  .pkgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; margin-bottom: 4rem; align-items: stretch; }
  .pkg { border: 1.5px solid var(--ink); border-radius: 6px; padding: 1.6rem; display: flex; flex-direction: column; gap: 1rem; background: var(--paper); }
  .pkg--top { background: var(--ink); color: var(--paper); }
  .pkg__name { margin: 0; font-size: var(--step--1); letter-spacing: .16em; text-transform: uppercase; }
  .pkg__price { margin: .4rem 0 .3rem; font-family: var(--font-display); font-stretch: var(--font-display-stretch); font-weight: 900; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; font-variant-numeric: tabular-nums; display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem .4rem; font-size: clamp(1.8rem, 3.2vw, 2.8rem); }
  .pkg__price small { font-family: var(--font-body); font-stretch: 100%; font-size: var(--step--1); font-weight: 500; opacity: .7; }
  .pkg--top .pkg__price span { color: var(--paper); }
  .pkg__tagline { margin: 0; color: var(--ink-2); }
  .pkg--top .pkg__tagline { color: rgba(244, 241, 234, .75); }
  .pkg__list { margin: 0; padding: 0; list-style: none; display: grid; gap: .55rem; font-size: var(--step--1); }
  .pkg__list li { padding-left: 1.2rem; position: relative; }
  .pkg__list li::before { content: ''; position: absolute; left: 0; top: .55em; width: .5rem; height: .5rem; background: var(--accent); border-radius: 1px; }
  .pkg__note { margin: auto 0 0; font-size: var(--step--1); color: var(--ink-2); border-top: 1px solid var(--line); padding-top: .8rem; }
  .pkg--top .pkg__note { color: rgba(244, 241, 234, .7); }

  .block { margin-bottom: 4rem; }
  .block__title { font-size: var(--step-1); margin: 0 0 .4rem; }
  .block__intro { margin: 0 0 1.4rem; color: var(--ink-2); max-width: 64ch; font-size: var(--step--1); }

  .care { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem; }
  .care li { background: var(--paper-2); padding: 1.3rem; border-radius: 6px; display: grid; gap: .25rem; align-content: start; }
  .care__price { color: var(--accent); font-weight: 700; font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .care__price small { font-size: var(--step--1); font-weight: 500; color: var(--ink-2); }
  .care p { margin: .4rem 0 0; font-size: var(--step--1); color: var(--ink-2); }

  .block__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .4rem; }
  .block__head .block__title { margin: 0; }
  .cur { display: inline-flex; border: 1.5px solid var(--ink); border-radius: 999px; padding: 3px; }
  .cur button { font: inherit; font-size: var(--step--1); font-weight: 600; border: 0; background: none; color: var(--ink); padding: .3em .9em; border-radius: 999px; cursor: pointer; transition: background .25s, color .25s; }
  .cur button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .c-usd { display: none; }
  .services[data-cur-scope="usd"] .c-usd { display: inline; }
  .services[data-cur-scope="usd"] .c-ttd { display: none; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; }
  .addons { width: 100%; min-width: 560px; border-collapse: collapse; font-size: var(--step--1); }
  .addons th, .addons td { text-align: left; padding: .8rem 1rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .addons thead th { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); font-weight: 600; background: var(--paper-2); }
  .addons tbody th { font-weight: 700; white-space: nowrap; }
  .addons td:nth-child(2) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .addons tr:last-child th, .addons tr:last-child td { border-bottom: 0; }

  .calc { border: 1.5px solid var(--ink); border-radius: 10px; padding: clamp(1.1rem, 3vw, 1.8rem); display: grid; gap: 1.2rem; max-width: 720px; background: var(--paper); }
  .calc__mode { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: .6rem; }
  .calc__mode label { display: flex; gap: .6rem; align-items: flex-start; border: 1px solid var(--line); border-radius: 8px; padding: .8rem; cursor: pointer; }
  .calc__mode label:has(input:checked) { border-color: var(--ink); background: var(--paper-2); }
  .calc__mode input { accent-color: var(--accent); margin-top: .2rem; }
  .calc__mode b { display: block; }
  .calc__mode small { color: var(--ink-2); font-size: var(--step--1); }
  .calc__row { display: grid; gap: .4rem; }
  .calc__creative:not([hidden]) { display: grid; gap: 1.2rem; }
  .calc__row span { display: flex; justify-content: space-between; font-weight: 600; font-size: var(--step--1); }
  .calc__row output { color: var(--accent); font-variant-numeric: tabular-nums; }
  .calc__row input { width: 100%; accent-color: var(--accent); }
  .calc__total { display: grid; gap: .2rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .calc__label { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .calc__total strong { font-family: var(--font-display); font-stretch: var(--font-display-stretch); font-weight: 900; font-size: clamp(1.6rem, 4vw, 2.4rem); color: var(--accent); line-height: 1.1; }
  .calc__total small { color: var(--ink-2); font-size: var(--step--1); }
  .calc__note { margin: 0; font-size: var(--step--1); color: var(--ink-2); }
  .ads { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1rem; }
  .ad { border: 1px solid var(--line); border-radius: 6px; padding: 1.3rem; }
  .ad h4 { margin: 0; font-size: var(--step-0); }
  .ad__price { margin: .3rem 0 .6rem; color: var(--accent); font-weight: 700; }
  .ad__price small { color: var(--ink-2); font-weight: 500; }
  .ad p { margin: 0 0 .6rem; font-size: var(--step--1); }
  .ad__hours { color: var(--ink-2); margin-bottom: 0 !important; }
</style>
<script>
  // Meta ads estimator: management base + per running ad, plus new creative when chosen.
  const form = document.querySelector<HTMLFormElement>('[data-calc]');
  if (form) {
    const R = JSON.parse(form.dataset.rates!);
    const scopeEl = document.querySelector<HTMLElement>('#services');
    const money = (usd: number) => scopeEl?.dataset.curScope === 'usd'
      ? 'US$' + Math.round(usd).toLocaleString('en-US')
      : 'TT$' + (Math.round((usd * R.usdToTtd) / 50) * 50).toLocaleString('en-US');
    const out = (k: string) => form.querySelector<HTMLOutputElement>(`[data-out="${k}"]`)!;
    const calc = () => {
      const f = new FormData(form);
      const creative = f.get('mode') === 'creative';
      const ads = Number(f.get('ads')), per = Number(f.get('per')), vid = Number(f.get('vid')) / 100;
      form.querySelector<HTMLElement>('[data-creative]')!.hidden = !creative;
      out('ads').value = String(ads); out('per').value = String(per); out('vid').value = Math.round(vid * 100) + '%';
      const manage = R.managementBase + R.perActiveAd * ads;
      const make = creative ? per * (R.creative.image * (1 - vid) + R.creative.video * vid) : 0;
      form.querySelector('[data-total]')!.textContent = money(manage + make) + ' / month';
      form.querySelector('[data-breakdown]')!.textContent = creative
        ? `Management ${money(manage)} + creative ${money(make)}`
        : `Management for ${ads} running ad${ads === 1 ? '' : 's'}`;
      form.querySelector('[data-minspend]')!.textContent = money(R.minSpendPerDayUsd) + ' a day';
    };
    form.addEventListener('input', calc);
    document.querySelectorAll('[data-cur-btn]').forEach((b) => b.addEventListener('click', () => requestAnimationFrame(calc)));
    calc();
  }

  // TTD by default; the switch flips every add-on and Meta ads price to USD.
  const scope = document.querySelector<HTMLElement>('#services');
  document.querySelectorAll<HTMLButtonElement>('[data-cur-btn]').forEach((b) => b.addEventListener('click', () => {
    const cur = b.dataset.curBtn!;
    scope?.setAttribute('data-cur-scope', cur);
    document.querySelectorAll<HTMLButtonElement>('[data-cur-btn]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
</script>
